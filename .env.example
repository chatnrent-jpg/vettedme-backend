# Database
DATABASE_URL="postgresql://user:password@localhost:5432/vetted_db?schema=public"

# Server
NODE_ENV="development"
PORT=3000
API_VERSION="v1"

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRY="7d"

# VettedME - Smile ID (Nigerian Biometric & KYC)
SMILE_ID_PARTNER_ID="your-smile-id-partner-id"
SMILE_ID_API_KEY="your-smile-id-api-key"
SMILE_ID_SANDBOX_MODE="true"
SMILE_ID_WEBHOOK_SECRET="your-smile-id-webhook-secret"

# VettedPay - Airwallex
AIRWALLEX_CLIENT_ID="your-airwallex-client-id"
AIRWALLEX_API_KEY="your-airwallex-api-key"
AIRWALLEX_ENVIRONMENT="demo"
AIRWALLEX_WEBHOOK_SECRET_KEY="your-airwallex-webhook-secret-key"

# Treasury Wallets
VETTED_TREASURY_WALLET_ID="your-treasury-wallet-id"
VETTED_ARBITRATION_WALLET_ID="your-arbitration-wallet-id"

# Webhook URLs (for external service configuration)
WEBHOOK_BASE_URL="http://localhost:3000"
VETTEDME_WEBHOOK_URL="http://localhost:3000/api/v1/webhooks/vettedme"
VETTEDPAY_HANDSHAKE_WEBHOOK_URL="http://localhost:3000/api/v1/webhooks/vettedpay/handshake"
AIRWALLEX_DEPOSIT_WEBHOOK_URL="http://localhost:3000/api/v1/webhooks/airwallex/deposit"
AIRWALLEX_PAYOUT_WEBHOOK_URL="http://localhost:3000/api/v1/webhooks/airwallex/payout"

# Security
ENCRYPTION_KEY="your-32-byte-encryption-key-change-this"
CORS_ORIGIN="http://localhost:3001"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
