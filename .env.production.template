# ============================================================================
# VETTED PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================================
# 
# CRITICAL: This is a template file with placeholder values.
# DO NOT commit actual production credentials to version control.
# 
# Usage:
# 1. Copy this file to .env.production
# 2. Replace all placeholder values with actual production credentials
# 3. Deploy to Railway/AWS with secure environment variable injection
# 
# Last Updated: July 20, 2026
# ============================================================================

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
NODE_ENV=production
PORT=8080
APP_NAME=VETTED
APP_VERSION=1.0.0
APP_URL=https://api.vetted.ai

# API Configuration
API_VERSION=v1
API_TIMEOUT=30000
API_MAX_REQUEST_SIZE=10mb

# ============================================================================
# REGIONAL ROUTING CONFIGURATION
# ============================================================================
# Primary Region: US East (Railway default)
# Edge Locations: Lagos (NG), Nairobi (KE), São Paulo (BR)
# ============================================================================

PRIMARY_REGION=us-east
EDGE_LOCATIONS=lagos-ng,nairobi-ke,sao-paulo-br,dubai-ae,london-uk

# CDN Configuration
CDN_ENABLED=true
CDN_CACHE_TTL=3600
CDN_STATIC_ASSETS_TTL=86400

# ============================================================================
# DATABASE CONFIGURATION (MULTI-REGION POSTGRESQL)
# ============================================================================

# Primary Database (Write Operations)
DATABASE_URL=postgresql://vetted_user:PRODUCTION_DB_PASSWORD_HERE@vetted-db-primary.railway.app:5432/vetted_production?schema=public&connection_limit=20&pool_timeout=10

# Read Replicas (Regional Routing)
DATABASE_READ_REPLICA_LAGOS=postgresql://vetted_user:PRODUCTION_DB_PASSWORD_HERE@vetted-db-lagos.railway.app:5432/vetted_production?schema=public&connection_limit=10
DATABASE_READ_REPLICA_NAIROBI=postgresql://vetted_user:PRODUCTION_DB_PASSWORD_HERE@vetted-db-nairobi.railway.app:5432/vetted_production?schema=public&connection_limit=10
DATABASE_READ_REPLICA_SAO_PAULO=postgresql://vetted_user:PRODUCTION_DB_PASSWORD_HERE@vetted-db-sao-paulo.railway.app:5432/vetted_production?schema=public&connection_limit=10

# Database Connection Pool Configuration
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=10000
DB_POOL_ACQUIRE_TIMEOUT=30000

# Database SSL Configuration
DB_SSL_ENABLED=true
DB_SSL_REJECT_UNAUTHORIZED=true

# ============================================================================
# REDIS CONFIGURATION (RATE LIMITING & CACHING)
# ============================================================================

# Primary Redis Instance
REDIS_URL=redis://default:PRODUCTION_REDIS_PASSWORD_HERE@vetted-redis-production.railway.app:6379

# Upstash Redis (Alternative/Backup)
UPSTASH_REDIS_REST_URL=https://UPSTASH_ENDPOINT_HERE.upstash.io
UPSTASH_REDIS_REST_TOKEN=UPSTASH_REST_TOKEN_HERE

# Redis Configuration
REDIS_MAX_RETRIES=3
REDIS_CONNECT_TIMEOUT=10000
REDIS_COMMAND_TIMEOUT=5000
REDIS_ENABLE_OFFLINE_QUEUE=true

# ============================================================================
# JWT & AUTHENTICATION CONFIGURATION
# ============================================================================

# JWT Secret (256-bit minimum, rotate every 90 days)
JWT_SECRET=PRODUCTION_JWT_SECRET_HERE_64_CHAR_MINIMUM_CRYPTOGRAPHICALLY_SECURE_RANDOM_STRING

# JWT Configuration
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d
JWT_ISSUER=vetted.ai
JWT_AUDIENCE=api.vetted.ai

# Session Configuration
SESSION_SECRET=PRODUCTION_SESSION_SECRET_HERE_64_CHAR_MINIMUM
SESSION_MAX_AGE=900000
SESSION_SECURE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict

# ============================================================================
# AIRWALLEX PRODUCTION LEDGER API
# ============================================================================
# Production credentials from Airwallex Dashboard
# Environment: Production
# Region: Global (Multi-Currency)
# ============================================================================

AIRWALLEX_ENVIRONMENT=production
AIRWALLEX_API_KEY=AIRWALLEX_PRODUCTION_API_KEY_HERE
AIRWALLEX_CLIENT_ID=AIRWALLEX_PRODUCTION_CLIENT_ID_HERE
AIRWALLEX_CLIENT_SECRET=AIRWALLEX_PRODUCTION_CLIENT_SECRET_HERE
AIRWALLEX_WEBHOOK_SECRET=AIRWALLEX_PRODUCTION_WEBHOOK_SECRET_HERE

# Airwallex API Configuration
AIRWALLEX_API_URL=https://api.airwallex.com/api/v1
AIRWALLEX_API_TIMEOUT=30000
AIRWALLEX_API_RETRY_ATTEMPTS=3

# Platform Treasury Wallets
AIRWALLEX_TREASURY_WALLET_USD=aw_wallet_usd_PRODUCTION_WALLET_ID_HERE
AIRWALLEX_TREASURY_WALLET_EUR=aw_wallet_eur_PRODUCTION_WALLET_ID_HERE
AIRWALLEX_TREASURY_WALLET_GBP=aw_wallet_gbp_PRODUCTION_WALLET_ID_HERE

# Fee Configuration
AIRWALLEX_PLATFORM_FEE_RATE=0.15
AIRWALLEX_FX_SPREAD_RATE=0.005

# ============================================================================
# SMILE ID LIVE BIOMETRIC GATEWAY
# ============================================================================
# Production credentials from Smile ID Dashboard
# Environment: Production
# Supported Countries: NG, KE, ZA, GH, UG, TZ
# ============================================================================

SMILE_ID_ENVIRONMENT=production
SMILE_ID_PARTNER_ID=SMILE_ID_PRODUCTION_PARTNER_ID_HERE
SMILE_ID_API_KEY=SMILE_ID_PRODUCTION_API_KEY_HERE
SMILE_ID_CALLBACK_URL=https://api.vetted.ai/webhooks/smile-id

# Smile ID API Configuration
SMILE_ID_API_URL=https://api.smileidentity.com/v2
SMILE_ID_API_TIMEOUT=60000
SMILE_ID_API_RETRY_ATTEMPTS=2

# Verification Configuration
SMILE_ID_MIN_CONFIDENCE_SCORE=0.90
SMILE_ID_LIVENESS_REQUIRED=true
SMILE_ID_ENABLE_DOCUMENT_VERIFICATION=true
SMILE_ID_ENABLE_BIOMETRIC_KYC=true

# ============================================================================
# PERSONA KYC PRODUCTION WEBHOOKS
# ============================================================================
# Production credentials from Persona Dashboard
# Environment: Production
# Supported Countries: US, UK, EU, CA, AU
# ============================================================================

PERSONA_ENVIRONMENT=production
PERSONA_API_KEY=PERSONA_PRODUCTION_API_KEY_HERE
PERSONA_TEMPLATE_ID=PERSONA_PRODUCTION_TEMPLATE_ID_HERE
PERSONA_WEBHOOK_SECRET=PERSONA_PRODUCTION_WEBHOOK_SECRET_HERE

# Persona API Configuration
PERSONA_API_URL=https://withpersona.com/api/v1
PERSONA_API_VERSION=2023-01-05
PERSONA_API_TIMEOUT=30000

# Verification Configuration
PERSONA_MIN_VERIFICATION_LEVEL=standard
PERSONA_ENABLE_GOVERNMENT_ID=true
PERSONA_ENABLE_SELFIE=true
PERSONA_ENABLE_LIVENESS=true

# ============================================================================
# ONFIDO ENTERPRISE VERIFICATION
# ============================================================================
# Production credentials from Onfido Dashboard
# Environment: Production (EU Data Center)
# Supported Countries: Global (190+ countries)
# ============================================================================

ONFIDO_ENVIRONMENT=production
ONFIDO_API_TOKEN=ONFIDO_PRODUCTION_API_TOKEN_HERE
ONFIDO_WEBHOOK_SECRET=ONFIDO_PRODUCTION_WEBHOOK_SECRET_HERE

# Onfido API Configuration
ONFIDO_API_URL=https://api.eu.onfido.com/v3
ONFIDO_API_TIMEOUT=30000
ONFIDO_API_RETRY_ATTEMPTS=2

# Verification Configuration
ONFIDO_WORKFLOW_ID=ONFIDO_PRODUCTION_WORKFLOW_ID_HERE
ONFIDO_ENABLE_DOCUMENT_CHECK=true
ONFIDO_ENABLE_FACIAL_SIMILARITY=true
ONFIDO_ENABLE_PROOF_OF_ADDRESS=false

# ============================================================================
# WISE (FORMERLY TRANSFERWISE) API
# ============================================================================
# Production credentials from Wise Business Dashboard
# Environment: Production
# ============================================================================

WISE_ENVIRONMENT=production
WISE_API_TOKEN=WISE_PRODUCTION_API_TOKEN_HERE
WISE_PROFILE_ID=WISE_PRODUCTION_PROFILE_ID_HERE
WISE_WEBHOOK_SECRET=WISE_PRODUCTION_WEBHOOK_SECRET_HERE

# Wise API Configuration
WISE_API_URL=https://api.transferwise.com
WISE_API_TIMEOUT=30000

# ============================================================================
# PAYONEER API
# ============================================================================
# Production credentials from Payoneer Partner Portal
# Environment: Production
# ============================================================================

PAYONEER_ENVIRONMENT=production
PAYONEER_USERNAME=PAYONEER_PRODUCTION_USERNAME_HERE
PAYONEER_PASSWORD=PAYONEER_PRODUCTION_PASSWORD_HERE
PAYONEER_PARTNER_ID=PAYONEER_PRODUCTION_PARTNER_ID_HERE

# Payoneer API Configuration
PAYONEER_API_URL=https://api.payoneer.com/v4
PAYONEER_API_TIMEOUT=30000

# ============================================================================
# AWS SERVICES (OPTIONAL - FOR ADVANCED FEATURES)
# ============================================================================

# S3 Storage (Document Uploads, W-8BEN Forms, etc.)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AWS_PRODUCTION_ACCESS_KEY_ID_HERE
AWS_SECRET_ACCESS_KEY=AWS_PRODUCTION_SECRET_ACCESS_KEY_HERE
AWS_S3_BUCKET_NAME=vetted-production-documents
AWS_S3_BUCKET_REGION=us-east-1

# CloudFront CDN (Static Assets)
AWS_CLOUDFRONT_DISTRIBUTION_ID=AWS_CLOUDFRONT_DISTRIBUTION_ID_HERE
AWS_CLOUDFRONT_DOMAIN=cdn.vetted.ai

# SES Email Service
AWS_SES_REGION=us-east-1
AWS_SES_FROM_EMAIL=notifications@vetted.ai
AWS_SES_REPLY_TO_EMAIL=support@vetted.ai

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================

# Sentry Error Tracking
SENTRY_DSN=SENTRY_PRODUCTION_DSN_HERE
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENABLE_TRACING=true

# LogDNA / LogTail
LOGDNA_INGESTION_KEY=LOGDNA_PRODUCTION_KEY_HERE
LOGDNA_HOSTNAME=vetted-api-production

# Datadog APM (Optional)
DD_API_KEY=DATADOG_PRODUCTION_API_KEY_HERE
DD_APP_KEY=DATADOG_PRODUCTION_APP_KEY_HERE
DD_SITE=datadoghq.com
DD_ENV=production
DD_SERVICE=vetted-api
DD_VERSION=1.0.0

# ============================================================================
# EMAIL & NOTIFICATIONS
# ============================================================================

# SendGrid Email Service
SENDGRID_API_KEY=SENDGRID_PRODUCTION_API_KEY_HERE
SENDGRID_FROM_EMAIL=notifications@vetted.ai
SENDGRID_FROM_NAME=VETTED Platform

# Twilio SMS (Optional - 2FA, Notifications)
TWILIO_ACCOUNT_SID=TWILIO_PRODUCTION_ACCOUNT_SID_HERE
TWILIO_AUTH_TOKEN=TWILIO_PRODUCTION_AUTH_TOKEN_HERE
TWILIO_PHONE_NUMBER=+1234567890

# ============================================================================
# RATE LIMITING & SECURITY
# ============================================================================

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS_MILESTONE=5
RATE_LIMIT_MAX_REQUESTS_WEBHOOK=100
RATE_LIMIT_MAX_REQUESTS_API=100

# Airwallex IP Whitelist (comma-separated CIDR ranges)
AIRWALLEX_IP_WHITELIST=52.62.0.0/15,54.240.0.0/12,13.52.0.0/16,18.130.0.0/16,52.220.0.0/15

# CORS Configuration
CORS_ORIGIN=https://vetted.ai,https://vettedme.com,https://vettedpay.ai
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400

# Security Headers
ENABLE_HELMET=true
ENABLE_HSTS=true
ENABLE_CSP=true

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Biometric Verification
FEATURE_SMILE_ID_ENABLED=true
FEATURE_PERSONA_ENABLED=true
FEATURE_ONFIDO_ENABLED=true

# Payment Providers
FEATURE_AIRWALLEX_ENABLED=true
FEATURE_WISE_ENABLED=true
FEATURE_PAYONEER_ENABLED=true

# Advanced Features
FEATURE_MULTI_CURRENCY_ENABLED=true
FEATURE_TAX_COMPLIANCE_ENABLED=true
FEATURE_DISPUTE_ARBITRATION_ENABLED=true
FEATURE_AUDIT_LOGGING_ENABLED=true

# ============================================================================
# BACKUP & DISASTER RECOVERY
# ============================================================================

# Database Backup Configuration
DB_BACKUP_ENABLED=true
DB_BACKUP_SCHEDULE=0 2 * * *
DB_BACKUP_RETENTION_DAYS=30
DB_BACKUP_S3_BUCKET=vetted-production-backups

# Redis Backup Configuration
REDIS_BACKUP_ENABLED=true
REDIS_BACKUP_SCHEDULE=0 3 * * *

# ============================================================================
# COMPLIANCE & REGULATIONS
# ============================================================================

# Data Residency
DATA_RESIDENCY_ENABLED=true
DATA_RESIDENCY_REGIONS=US,EU,NG,KE,BR

# Encryption
ENCRYPTION_AT_REST_ENABLED=true
ENCRYPTION_IN_TRANSIT_ENABLED=true
ENCRYPTION_ALGORITHM=AES-256-GCM

# Audit Logging
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=2555
AUDIT_LOG_IMMUTABLE=true

# ============================================================================
# END OF CONFIGURATION
# ============================================================================
# 
# SECURITY CHECKLIST:
# [ ] All placeholder values replaced with production credentials
# [ ] JWT_SECRET is cryptographically secure (256-bit minimum)
