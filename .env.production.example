# ===============================================
# VETTED Production Environment Configuration
# ===============================================
# 
# CRITICAL: This file contains production secrets
# - Copy this file to .env.production
# - Fill in all values with PRODUCTION credentials
# - NEVER commit .env.production to version control
# - Store secrets in secure vault (AWS Secrets Manager, HashiCorp Vault, etc.)
#
# ===============================================

# ===============================================
# APPLICATION
# ===============================================
NODE_ENV=production
PORT=8080
API_VERSION=v1

# ===============================================
# DATABASE (PostgreSQL)
# ===============================================
# Production database connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://vetted_master:CHANGE_THIS_PASSWORD@vetted-db-cluster:5432/vetted_ledger?schema=public"

# ===============================================
# JWT AUTHENTICATION
# ===============================================
# CRITICAL: Generate a strong random key (32+ characters)
# Command: openssl rand -base64 32
JWT_SECRET_SIGNING_KEY="CHANGE_THIS_TO_RANDOM_64_CHAR_STRING_USE_OPENSSL_RAND_BASE64_32"
JWT_EXPIRY="7d"

# ===============================================
# VETTEDME - SMILE ID (Biometric Verification)
# ===============================================
# Production Smile ID credentials
# Obtain from: https://portal.smileidentity.com
SMILE_ID_PARTNER_ID="YOUR_PRODUCTION_PARTNER_ID"
SMILE_ID_API_KEY="YOUR_PRODUCTION_API_KEY"
SMILE_ID_SANDBOX_MODE="false"
SMILE_ID_WEBHOOK_SECRET="YOUR_PRODUCTION_WEBHOOK_SECRET"

# ===============================================
# VETTEDPAY - AIRWALLEX (Payment Settlement)
# ===============================================
# Production Airwallex credentials
# Obtain from: https://www.airwallex.com/app
AIRWALLEX_CLIENT_ID="YOUR_PRODUCTION_CLIENT_ID"
AIRWALLEX_API_KEY="YOUR_PRODUCTION_API_KEY"
AIRWALLEX_ENVIRONMENT="production"
AIRWALLEX_WEBHOOK_SECRET_KEY="YOUR_PRODUCTION_WEBHOOK_SECRET"

# ===============================================
# TREASURY & ARBITRATION WALLETS
# ===============================================
# Platform fee collection wallet (15% take-rate)
VETTED_TREASURY_WALLET_ID="YOUR_TREASURY_WALLET_ID"

# Dispute arbitration escrow wallet
VETTED_ARBITRATION_WALLET_ID="YOUR_ARBITRATION_WALLET_ID"

# ===============================================
# WEBHOOK URLS (Production)
# ===============================================
# Base URL for your production API
WEBHOOK_BASE_URL="https://api.vetted.com"

# Full webhook endpoints (auto-constructed)
VETTEDME_WEBHOOK_URL="https://api.vetted.com/api/v1/webhooks/vettedme"
VETTEDPAY_HANDSHAKE_WEBHOOK_URL="https://api.vetted.com/api/v1/webhooks/vettedpay/handshake"
AIRWALLEX_DEPOSIT_WEBHOOK_URL="https://api.vetted.com/api/v1/webhooks/airwallex/deposit"
AIRWALLEX_PAYOUT_WEBHOOK_URL="https://api.vetted.com/api/v1/webhooks/airwallex/payout"

# ===============================================
# SECURITY
# ===============================================
# Encryption key for sensitive data (32 bytes)
# Command: openssl rand -base64 32
ENCRYPTION_KEY="CHANGE_THIS_TO_RANDOM_44_CHAR_STRING_USE_OPENSSL_RAND_BASE64_32"

# CORS allowed origins (comma-separated)
CORS_ORIGIN="https://app.vetted.com,https://vetted.com"

# ===============================================
# RATE LIMITING
# ===============================================
# Time window in milliseconds (15 minutes default)
RATE_LIMIT_WINDOW_MS=900000

# Max requests per window
RATE_LIMIT_MAX_REQUESTS=100

# ===============================================
# LOGGING & MONITORING (Optional)
# ===============================================
# Datadog APM
DD_AGENT_HOST="datadog-agent"
DD_TRACE_ENABLED="true"
DD_ENV="production"
DD_SERVICE="vetted-api"
DD_VERSION="1.0.0"

# Sentry Error Tracking
SENTRY_DSN="YOUR_SENTRY_DSN_URL"
SENTRY_ENVIRONMENT="production"

# ===============================================
# SMTP (Email Notifications) - Optional
# ===============================================
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASSWORD="YOUR_SENDGRID_API_KEY"
SMTP_FROM_EMAIL="no-reply@vetted.com"
SMTP_FROM_NAME="VETTED Platform"

# ===============================================
# AWS (S3 Storage for Documents) - Optional
# ===============================================
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY"
AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_KEY"
AWS_S3_BUCKET="vetted-production-documents"

# ===============================================
# REDIS CACHE (Optional)
# ===============================================
REDIS_URL="redis://vetted-redis-cache:6379"
REDIS_PASSWORD=""

# ===============================================
# PRODUCTION CHECKLIST
# ===============================================
# Before deploying, ensure:
# [ ] All secrets are changed from example values
# [ ] Database backups are configured
# [ ] SSL/TLS certificates are valid
# [ ] Firewall rules are configured
# [ ] Monitoring alerts are set up
# [ ] Rate limiting is configured
# [ ] CORS origins are whitelisted
# [ ] Webhook URLs are registered with external services
# [ ] Health check endpoint is accessible
# [ ] Log aggregation is configured
# [ ] Auto-scaling rules are defined
# [ ] Disaster recovery plan is documented
