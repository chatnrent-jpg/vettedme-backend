{
  "name": "vetted-backend",
  "version": "1.0.0",
  "description": "VETTED - B2B Trust Infrastructure Protocol for Cross-Border Tech Talent",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset && npm run db:seed",
    "db:studio": "prisma studio",
    "lint": "eslint src --ext .ts",
    "test": "jest",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:e2e": "tsx tests/integration/end-to-end.test.ts",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "load:k6": "k6 run tests/load/k6-load-test.js",
    "load:autocannon": "node tests/load/autocannon-load-test.js",
    "load:all": "npm run load:k6 && npm run load:autocannon",
    "scrape:github": "tsx scripts/talent/github_scraper.ts",
    "scrape:lagos": "tsx scripts/talent/github_scraper.ts -- --corridor=lagos --limit=200",
    "scrape:nairobi": "tsx scripts/talent/github_scraper.ts -- --corridor=nairobi --limit=150",
    "scrape:saopaulo": "tsx scripts/talent/github_scraper.ts -- --corridor=saopaulo --limit=150",
    "scrape:all": "npm run scrape:lagos && npm run scrape:nairobi && npm run scrape:saopaulo",
    "validate:leads": "tsx scripts/demand/lead_validator.ts"
  },
  "keywords": [
    "vetted",
    "vettedme",
    "vettedpay",
    "airwallex",
    "biometric",
    "trust-infrastructure"
  ],
  "author": "VETTED",
  "license": "PROPRIETARY",
  "dependencies": {
    "@prisma/client": "^7.9.0",
    "express": "^4.19.2",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8",
    "axios": "^1.7.2",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.3.1",
    "winston": "^3.13.0",
    "uuid": "^10.0.0",
    "crypto": "^1.0.1",
    "pdf-lib": "^1.17.1",
    "ioredis": "^5.4.1",
    "rate-limiter-flexible": "^5.0.3",
    "@sentry/node": "^7.114.0",
    "@sentry/profiling-node": "^7.114.0",
    "@sentry/integrations": "^7.114.0",
    "dd-trace": "^5.8.0",
    "@octokit/rest": "^20.1.1",
    "json2csv": "^6.0.0-alpha.2",
    "csv-parse": "^5.5.6",
    "csv-stringify": "^6.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/uuid": "^10.0.0",
    "@types/ioredis": "^4.28.10",
    "@types/json2csv": "^5.0.7",
    "typescript": "^5.5.3",
    "tsx": "^4.16.2",
    "prisma": "^7.9.0",
    "eslint": "^9.6.0",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.12",
    "ts-jest": "^29.2.2",
    "autocannon": "^7.15.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
